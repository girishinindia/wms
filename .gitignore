# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Vendored by scripts/vendor-scalar.mjs during prebuild. 3.6 MB of
# third-party bundle does not belong in git — the version is pinned by
# package.json, which is what should be reviewed.
/public/scalar/

# ── Mount artefacts ───────────────────────────────────────────
# The Cowork device mount refuses unlink, so a file replaced while
# something still holds it open reappears under this name. Never
# content, always a stale copy of whatever was just rewritten.
.fuse_hidden*

# Files Cowork moved aside instead of deleting; safe to remove.
_to_delete/
